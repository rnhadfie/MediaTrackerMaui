<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:book="clr-namespace:MauiApp1.Front.Components.Books"
    xmlns:local="clr-namespace:MauiApp1"
    Title="MauiApp1">

    <!-- Flyout menu with Home and Books entries -->
    <FlyoutItem Title="Home">
        <ShellContent Title="Home" ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Books">
        <ShellContent Title="Book Home" ContentTemplate="{DataTemplate book:BookHome}" Route="BookHome" />
        <ShellContent Title="Add Book" ContentTemplate="{DataTemplate book:BookForm}" Route="BookForm" IsVisible="False" />
        <ShellContent Title="Add" Route="BookForm" ContentTemplate="{DataTemplate book:BookForm}" />
    </FlyoutItem>

    <!-- Use MenuItems for route-based absolute navigation -->
    <MenuItem Text="Books" Clicked="OnMenuBooksClicked" />
    <MenuItem Text="Home" Clicked="OnMenuHomeClicked" />

</Shell>
