<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:book="clr-namespace:MauiApp1.Front.Components.Books"
    xmlns:video="clr-namespace:MauiApp1.Front.Components.Videos"
    xmlns:local="clr-namespace:MauiApp1"
    Title="MauiApp1">

    <!--  Flyout menu with Home and Books entries  -->
    <FlyoutItem Title="Home">
        <ShellContent Title="Home" ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Videos" Route="videohome">
        <Tab Title="Videos" Route="videos">
            <ShellContent ContentTemplate="{DataTemplate video:VideoHome}" Route="VideoHome" />
        </Tab>

        <!-- Series tab removed: Video series are now embedded in VideoHome -->

        <Tab Title="Add" IsVisible="False">
            <ShellContent ContentTemplate="{DataTemplate video:VideoForm}" Route="VideoForm" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="Books" Route="books">
        <!-- Make BookHome the default tab by placing it first and assigning the shared 'books' route to it -->
        <Tab Title="Books" Route="books">
            <ShellContent ContentTemplate="{DataTemplate book:BookHome}" Route="BookHome" />
        </Tab>

        <!-- Series tab removed: Book series are now embedded in BookHome -->

        <Tab Title="Add" IsVisible="False">
            <ShellContent ContentTemplate="{DataTemplate book:BookForm}" Route="BookForm" />
        </Tab>
    </FlyoutItem>

    <!--  Use MenuItems for route-based absolute navigation  -->
    <MenuItem Clicked="OnImportDataClicked" Text="Import Data" />

    <!--  Use MenuItems for route-based absolute navigation  -->
    <MenuItem Clicked="OnExportDataClicked" Text="Export Data" />

</Shell>
