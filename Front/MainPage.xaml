<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:book="clr-namespace:MauiApp1.Front.Components.Books"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    Title="">
    <VerticalStackLayout>
        <Label
            FontSize="16"
            HorizontalOptions="Center"
            Text="Hello, World!" />
        <StackLayout Padding="10" StyleClass="PrimaryContainer">
            <Label Text="Books" />
            <Button Clicked="OnOpenBooksClicked" Text="Open Books" />
        </StackLayout>
        <StackLayout Padding="10" StyleClass="PrimaryContainer">
            <Label Text="Videos" />
            <Button Clicked="OnOpenVideoClicked" Text="Open Videos" />
        </StackLayout>


    </VerticalStackLayout>
</ContentPage>

