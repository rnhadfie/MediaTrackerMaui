<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1.Components.ScrollDisplay">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Fill">
            <Label
                SemanticProperties.HeadingLevel="Level1"
                Style="{StaticResource Headline}"
                Text="Hello" />
            <local:ScrollViewDisplay x:Name="SeriesScrollView"   MediaType="Series" LabelText="Series"/>
            <local:ScrollViewDisplay x:Name="VideoScrollView"  MediaType="Video" LabelText="Movies and Tv Shows"/>
            <local:ScrollViewDisplay x:Name="BookScrollView"  MediaType="Book" LabelText="Books"/>
            <ImageButton
                x:Name="AddItem"
                AnchorX="24"
                AnchorY="24"
                Clicked="OnOpenMenu"
                HeightRequest="36"
                HorizontalOptions="End"
                Source="icons_add_50.png"
                VerticalOptions="End"
                WidthRequest="36" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

