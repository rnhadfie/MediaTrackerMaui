<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Front.Components.Music.MusicView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1.Components.ScrollDisplay"
    Title="">
    <ScrollView Orientation="Vertical">
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Fill">
            <Label
                HorizontalOptions="Center"
                Text="Cds"
                VerticalOptions="Center" />
            <local:ScrollViewDisplay x:Name="MusicView_All" LabelText="All" />
            <local:ScrollViewDisplay x:Name="MusicView_Series" LabelText="Series" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>