<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Components.ScrollDisplay.ScrollView"
             xmlns:local="clr-namespace:MauiApp1.Components.ScrollDisplay">
                
    <VerticalStackLayout>
        <Label
      SemanticProperties.HeadingLevel="Level1"
      Style="{StaticResource SubHeadline}"
                            HorizontalOptions="Start"
      Text="Series" />
        <HorizontalStackLayout>
            <local:ScrollViewItem ClassId="1" />
            <local:ScrollViewItem ClassId="2" />
            <local:ScrollViewItem ClassId="3" />
            <local:ScrollViewItem ClassId="4" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentView>
