<ContentView
    x:Class="MauiApp1.Components.ScrollDisplay.ScrollViewDisplay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1.Components.ScrollDisplay"
    x:Name="root">

    <VerticalStackLayout>
        <Label
            x:Name="ScrollView_Label"
            HorizontalOptions="Start"
            Style="{StaticResource SubHeadline}"
            Text="{Binding Source={x:Reference root}, Path=LabelText}" />
        <ScrollView Orientation="Horizontal">
            <StackLayout x:Name="ScrollView_Scroll"  Orientation="Horizontal">
                <Label x:Name ="EmptyList" HorizontalOptions="Center" FontSize="16" TextColor="Black"/>
            </StackLayout>
        </ScrollView>
    </VerticalStackLayout>
</ContentView>


