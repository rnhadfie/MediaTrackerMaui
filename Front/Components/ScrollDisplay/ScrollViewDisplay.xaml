<ContentView
    x:Class="MauiApp1.Components.ScrollDisplay.ScrollViewDisplay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1.Components.ScrollDisplay"
    x:Name="root">

    <VerticalStackLayout>
        <Label
            x:Name="ScrollView_Label"
            HorizontalOptions="Start"
            Style="{StaticResource SubHeadline}"
            Text="{Binding Source={x:Reference root}, Path=LabelText}" />
        <ScrollView Orientation="Horizontal">
            <HorizontalStackLayout>
                <StackLayout x:Name="ScrollView_Scroll" Orientation="Horizontal">
                    <Label
                        x:Name="EmptyList"
                        FontSize="16"
                        HorizontalOptions="Center"
                        TextColor="Black" />
                </StackLayout>
                <ImageButton
                    x:Name="ScrollView_Arrow"
                    BackgroundColor="Transparent"
                    Clicked="onMenuSelected"
                    HeightRequest="30"
                    HorizontalOptions="End"
                    Source="icons_next_50.png"
                    VerticalOptions="Center"
                    WidthRequest="30" />
            </HorizontalStackLayout>
        </ScrollView>
    </VerticalStackLayout>
</ContentView>


