<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiApp1.Components.ScrollDisplay.ScrollViewItem"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="ScrollViewItem_root">
    <ContentView.GestureRecognizers>
        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="ContentView_Tapped" />
    </ContentView.GestureRecognizers>

    <VerticalStackLayout Padding="8,8,8,8">
        <Grid>
            <Image
                x:Name="ScrollViewItem_Image"
                Aspect="AspectFill"
                Background="MediumPurple"
                HeightRequest="180"
                SemanticProperties.Description=""
                WidthRequest="130" />
            <Label
                x:Name="ScrollViewItem_ImageLabel"
                FontSize="26"
                HorizontalOptions="Center"
                Text=""
                TextColor="White"
                VerticalOptions="Center" />
        </Grid>
        <Label
            x:Name="ScrollViewItem_Label"
            HorizontalOptions="Center"
            Text="{Binding LabelText, Source={x:Reference ScrollViewItem_root}}"
            VerticalOptions="Center"
            WidthRequest="130" />
    </VerticalStackLayout>
</ContentView>
