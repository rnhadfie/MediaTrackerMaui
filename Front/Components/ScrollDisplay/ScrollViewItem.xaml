<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiApp1.Components.ScrollDisplay.ScrollViewItem"    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="ScrollViewItem_root">
    <ContentView.GestureRecognizers>
        <TapGestureRecognizer Tapped="ContentView_Tapped" NumberOfTapsRequired="1" />
    </ContentView.GestureRecognizers>
    
    <VerticalStackLayout Padding="8,8,8,8" >
        <Grid>
            <Image x:Name="ScrollViewItem_Image"
                    Background="MediumPurple"
                    WidthRequest="130"
                    HeightRequest="180"
                    SemanticProperties.Description=""
                   Aspect="AspectFill"
                   />
            <Label x:Name="ScrollViewItem_ImageLabel"
            Text="" 
            TextColor="White" 
            FontSize="26" 
            HorizontalOptions="Center" 
            VerticalOptions="Center" />
        </Grid>
        <Label
                x:Name="ScrollViewItem_Label"
                WidthRequest="130"
                HorizontalOptions="Center"
                Text="{Binding LabelText, Source={x:Reference ScrollViewItem_root}}"
                VerticalOptions="Center" />
    </VerticalStackLayout>
</ContentView>
