<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Components.SubMenuItem"
             >
    <VerticalStackLayout>
        <Button 
            x:Name="barcodeBtn" 
            Text="Add using Barcode" 
            BorderColor="#000000"
            BackgroundColor="#FFFFFF" 
            TextColor="Black" 
            Clicked="onUseBarcode"
            />
        <Button 
            x:Name="isbnBtn" 
            Text="Add using ISBN search" 
            TextColor="Black" 
            BorderColor="#000000" 
            BackgroundColor="#FFFFFF"
            Clicked="onSearchIsbn"
            />
        <Button 
            x:Name="manual" 
            Text="Add Manually" 
            TextColor="Black" 
            BorderColor="#000000" 
            BackgroundColor="#FFFFFF"
            Clicked="onEnterManually"
        />
    </VerticalStackLayout>
</ContentView>
