<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiApp1.Components.SubMenuItem"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout>
        <Button
            x:Name="barcodeBtn"
            BackgroundColor="#FFFFFF"
            BorderColor="#000000"
            Text="Add using Barcode"
            TextColor="Black" />
        <Button
            x:Name="isbnBtn"
            BackgroundColor="#FFFFFF"
            BorderColor="#000000"
            Text="Add using ISBN search"
            TextColor="Black" />
        <Button
            x:Name="manual"
            BackgroundColor="#FFFFFF"
            BorderColor="#000000"
            Text="Add Manually"
            TextColor="Black" />
    </VerticalStackLayout>
</ContentView>
