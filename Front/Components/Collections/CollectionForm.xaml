<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Front.Components.Collections.CollectionForm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1.Front.Components.Shared"
    xmlns:maui="clr-namespace:Microsoft.Maui;assembly=Microsoft.Maui">
    <Grid ColumnDefinitions="*">
        <VerticalStackLayout
            x:Name="AddCollectionForm"
            HorizontalOptions="Fill"
            VerticalOptions="Start">
            <Label
                HorizontalOptions="Center"
                Text="Add Collection"
                VerticalOptions="Center" />

            <local:TextField
                x:Name="Series_TitleTextField"
                FieldClassId="title"
                HorizontalOptions="Fill"
                PlaceholderText="Title" />
            <local:TextField
                x:Name="Series_AuthorTextField"
                FieldClassId="author"
                HorizontalOptions="Fill"
                PlaceholderText="Author" />
            <local:TextField
                x:Name="Series_ArtistTextField"
                FieldClassId="artist"
                HorizontalOptions="Fill"
                PlaceholderText="Artist" />
            <local:TextField
                x:Name="Series_publisherTextField"
                FieldClassId="publisher"
                HorizontalOptions="Fill"
                PlaceholderText="Publisher" />
            <local:RadioButtons
               x:Name="Series_Status"
               HorizontalOptions="Start"
               LabelText="Status"
               Source="{Binding _viewModel.ListOfSeriesStatus}" />
            <local:RadioButtons
               x:Name="Series_Type"
               HorizontalOptions="Start"
               LabelText="Category"
               Source="{Binding _viewModel.ListOfMediaTypes}" />
            <local:TextField
                x:Name="Series_VolumeTextField"
                FieldClassId="totalVolumes"
                HorizontalOptions="Start"
                InputFieldType="{x:Static maui:Keyboard.Numeric}"
                PlaceholderText="Total"
                TextWidth="150" />
            <HorizontalStackLayout Padding="4" HorizontalOptions="End">
                <Button
                    Margin="4"
                    Clicked="Button_Clicked"
                    HorizontalOptions="End"
                    Text="Cancel" />
                <Button
                    Margin="4"
                    Clicked="AddButton_Clicked"
                    HorizontalOptions="End"
                    Text="Add Book" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
