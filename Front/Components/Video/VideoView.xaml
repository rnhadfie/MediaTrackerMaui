<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Front.Components.Video.VideoView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1.Components.ScrollDisplay"
    Title="">
    <ScrollView Orientation="Vertical">
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Fill">
            <Label
                HorizontalOptions="Center"
                Text="Videos"
                VerticalOptions="Center" />
            <local:ScrollViewDisplay x:Name="VideoView_All" LabelText="All" />
            <local:ScrollViewDisplay x:Name="VideoView_Series" LabelText="Series" />
            <local:ScrollViewDisplay x:Name="VideoView_Anime" LabelText="Anime" />
            <local:ScrollViewDisplay x:Name="VideoView_WesternAnimation" LabelText="Western Animation" />
            <local:ScrollViewDisplay x:Name="VideoView_LiveAction" LabelText="Live action" />
            <local:ScrollViewDisplay x:Name="VideoView_Movies" LabelText="Movies" />
            <local:ScrollViewDisplay x:Name="VideoView_TvShows" LabelText="TV Shows" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>