<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    x:Class="MauiApp1.Front.Components.Video.VideoDetailView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
xmlns:local="clr-namespace:MauiApp1.Front.Components.Shared"
Title="">
    <ScrollView x:Name="bookLayout" Orientation="Both">
        <VerticalStackLayout>
            <Label
            HorizontalOptions="Center"
            Style="{StaticResource Headline}"
            Text="Videos"
            VerticalOptions="Center" />
            <ImageButton
            Clicked="ImageButton_Clicked"
            HorizontalOptions="End"
            Source="icons_add_50.png"
            WidthRequest="25" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <VerticalStackLayout Grid.Column="0">
                    <ScrollView>
                        <local:ItemGrid
                        x:Name="VideoGridView"
                        SizeChanged="OnGridSizeChanged" />
                    </ScrollView>
                </VerticalStackLayout>
                <local:Drawer
                x:Name="FilterDrawer"
                Grid.Column="1"
                Padding="0,16"
                IsVisible="Hidden">
                    <VerticalStackLayout>
                        <HorizontalStackLayout Background="MediumPurple">
                            <Label
                            HorizontalOptions="Center"
                            Text="Filter"
                            VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <local:TextField
                        x:Name="VideoDetailView_Search"
                        Padding="8,8,8,8"
                        HorizontalOptions="End"
                        PlaceholderText="Search"
                        WidthRequest="200" />
                        <local:Combobox
                        x:Name="VideoDetailView_Type"
                        Padding="8,8,8,8"
                        PlaceholderText="Type"
                        VerticalOptions="Fill" />
                        <local:Combobox
                        x:Name="VideoDetailView_Group"
                        Padding="8,8,8,8"
                        PlaceholderText="Format"
                        VerticalOptions="Fill" />
                        <local:Combobox
                        x:Name="BookDetailView_Genre"
                        Padding="8,8,8,8"
                        PlaceholderText="Genre"
                        VerticalOptions="Fill" />
                        <HorizontalStackLayout>
                            <Button
                            Padding="8,8,8,8"
                            Clicked="ImageButton_Clicked"
                            HorizontalOptions="Start"
                            Text="Cancel" />
                            <Button
                            Padding="8,8,8,8"
                            Clicked="FilterButton_Clicked"
                            HorizontalOptions="End"
                            Text="Filter" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </local:Drawer>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>