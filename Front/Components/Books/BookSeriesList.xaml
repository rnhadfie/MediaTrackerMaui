<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiApp1.Front.Components.Books.BookSeriesList"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    x:Name="this">
    <ScrollView>
        <VerticalStackLayout>
            <HorizontalStackLayout>
                <Grid
                    Padding="20"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="16">
                    <material:TextField
                        Title="Search"
                        Grid.Column="0"
                        HorizontalOptions="FillAndExpand"
                        Text="{Binding SearchText, Source={x:Reference this}}"
                        TextChanged="TextField_TextChanged"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        Clicked="AddButton_Clicked"
                        HorizontalOptions="End"
                        Text="Add"
                        VerticalOptions="Center" />
                </Grid>
            </HorizontalStackLayout>
            <material:DataGrid x:Name="BookSeriesListDataGrid" ItemsSource="{Binding ItemsSource, Source={x:Reference this}}">

                <material:DataGrid.EmptyView>
                    <Label
                        Padding="12"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding EmptyViewText, Source={x:Reference this}}"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />
                </material:DataGrid.EmptyView>

                <material:DataGrid.Columns>
                    <material:DataGridColumn x:Name="TextColumn" Width="*">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <Label FontAttributes="Bold" Text="{Binding Title}" />
                                    <Label FontAttributes="Italic" Text="{Binding Author}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                    <material:DataGridColumn Title="Actions" ValueBinding="{Binding Id}">
                        <material:DataGridColumn.CellItemTemplate>
                            <DataTemplate>
                                <Button
                                    Clicked="Button_Clicked"
                                    CommandParameter="{Binding .}"
                                    FontAttributes="Bold"
                                    Text="..." />
                            </DataTemplate>
                        </material:DataGridColumn.CellItemTemplate>
                    </material:DataGridColumn>
                </material:DataGrid.Columns>
            </material:DataGrid>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
