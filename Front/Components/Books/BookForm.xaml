<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Front.Components.Books.BookForm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Microsoft.Maui.Controls.Compatibility;assembly=Microsoft.Maui.Controls.Compatibility"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:models1="clr-namespace:MauiApp1.BackEnd"
    xmlns:models2="clr-namespace:MauiApp1.BackEnd.Shared"
    xmlns:models3="clr-namespace:MauiApp1.BackEnd.Models"
    xmlns:shared="clr-namespace:MauiApp1.Front.Components.Shared"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:viewModels="clr-namespace:MauiApp1.Front.Components.Books.ViewModels"
    Title="Book Form">
    <ContentPage.BindingContext>
        <viewModels:BookFormViewModel />
    </ContentPage.BindingContext>
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Scrollable content so dialog height constraints don't hide inputs  -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout>
                <material:TextField
                    x:Name="BookTitle"
                    Title="Title"
                    Padding="8"
                    IsEnabled="{Binding IsEdit.Value}"
                    Text="{Binding Title.Value, Mode=TwoWay}" />
                <material:TextField
                    x:Name="BookAuthor"
                    Title="Author"
                    Padding="8"
                    IsEnabled="{Binding IsEdit.Value}"
                    Text="{Binding Author.Value, Mode=TwoWay}" />
                <material:TextField
                    x:Name="BookArtist"
                    Title="Artist"
                    Padding="8"
                    IsEnabled="{Binding IsEdit.Value, Mode=TwoWay}"
                    Text="{Binding Artist.Value, Mode=TwoWay}" />
                <!--  Book items are managed per-book below  -->
                <StackLayout Padding="8">
                    <Label Text="Items" />
                    <CollectionView
                        x:Name="BookItemsCollection"
                        ItemsSource="{Binding BookItems}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6" ColumnDefinitions="*,Auto,Auto">
                                    <VerticalStackLayout>
                                        <Label FontAttributes="Bold" Text="{Binding VolumeNumber}" />
                                        <Label Text="{Binding VolumeTitle}" />
                                    </VerticalStackLayout>
                                    <Button
                                        Clicked="OnEditItemClicked"
                                        CommandParameter="{Binding .}"
                                        Text="Edit" />
                                    <Button
                                        Clicked="OnRemoveItemClicked"
                                        CommandParameter="{Binding .}"
                                        Text="Remove" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button
                        x:Name="AddItemButton"
                        Clicked="OnAddItemClicked"
                        Text="Add Item" />
                </StackLayout>



                <material:PickerField
                    x:Name="BookPublisherPicker"
                    Title="Publisher"
                    Padding="8"
                    IsEnabled="{Binding IsEdit.Value, Mode=TwoWay}"
                    ItemDisplayBinding="{Binding Text}"
                    SelectedItem="{Binding SelectedPublisher.Value, Mode=TwoWay}" />
                <material:TextField
                    x:Name="NewPublisher"
                    Title="New Publisher"
                    Padding="8"
                    IsEnabled="{Binding EnablePublisher}"
                    IsVisible="{Binding IsEdit.Value, Mode=TwoWay}"
                    Text="{Binding NewPublisher.Value, Mode=TwoWay}" />
                <StackLayout Padding="8">
                    <shared:MultiSelect
                        x:Name="BookGenrePicker"
                        Margin="8"
                        Editable="{Binding IsEdit.Value, Mode=TwoWay}"
                        Header="Genres"
                        ItemsSource="{Binding GenreOptions}"
                        SelectedValues="{Binding Genre, Mode=TwoWay}"
                        VerticalOptions="Fill" />
                </StackLayout>
                <material:CheckBox
                    Padding="8"
                    IsChecked="{Binding Ongoing.Value, Mode=TwoWay}"
                    IsEnabled="{Binding IsEdit}"
                    Text="Ongoing Series" />
                <material:CheckBox
                    Padding="8"
                    IsChecked="{Binding Collecting.Value, Mode=TwoWay}"
                    IsEnabled="{Binding IsEdit}"
                    Text="Collecting" />
                <material:CheckBox
                    Padding="8"
                    IsChecked="{Binding Completed.Value, Mode=TwoWay}"
                    IsEnabled="{Binding IsEdit}"
                    Text="Completed" />

                <material:PickerField
                    x:Name="BookTagPicker"
                    Title="Tag"
                    Padding="8"
                    IsEnabled="{Binding IsEdit.Value, Mode=TwoWay}"
                    ItemDisplayBinding="{Binding Text}"
                    SelectedItem="{Binding SelectedTag.Value, Mode=TwoWay}" />
                <material:TextField
                    x:Name="NewTag"
                    Title="New Tag"
                    Padding="8"
                    IsEnabled="{Binding EnableTag}"
                    IsVisible="{Binding IsEdit.Value, Mode=TwoWay}"
                    Text="{Binding NewTag.Value, Mode=TwoWay}" />
            </VerticalStackLayout>
        </ScrollView>

        <!--  Footer row pinned to bottom so buttons remain visible  -->
        <FlexLayout
            Grid.Row="1"
            Margin="10"
            Direction="Row"
            JustifyContent="End">
            <Button
                x:Name="CancelButton"
                Clicked="OnCancelClicked"
                Text="Back" />
            <Button
                x:Name="SubmitButton"
                Clicked="OnSubmitClicked"
                IsVisible="{Binding IsEdit}"
                Text="Save" />
        </FlexLayout>
    </Grid>
</ContentPage>
