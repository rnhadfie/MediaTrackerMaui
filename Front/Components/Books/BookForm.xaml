<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Components.Books.BookForm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1.Front.Components.Shared"
    xmlns:maui="clr-namespace:Microsoft.Maui;assembly=Microsoft.Maui">
    <ScrollView>
        <VerticalStackLayout>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <VerticalStackLayout
                    x:Name="AddBookForm"
                    Grid.Column="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start">
                    <Label
                        HorizontalOptions="Center"
                        Text="Add Book"
                        VerticalOptions="Center" />
                    <local:Combobox
                        x:Name="Book_SeriesCombobox"
                        HorizontalOptions="Fill"
                        PlaceholderText="Series"
                        SelectionChanged="SeriesCombobox_SelectionChanged" />
                    <local:TextField
                        x:Name="Book_TitleTextField"
                        FieldClassId="title"
                        HorizontalOptions="Fill"
                        PlaceholderText="Title" />
                    <local:TextField
                        x:Name="Book_AuthorTextField"
                        FieldClassId="author"
                        HorizontalOptions="Fill"
                        PlaceholderText="Author" />
                    <local:TextField
                        x:Name="Book_ArtistTextField"
                        FieldClassId="artist"
                        HorizontalOptions="Fill"
                        PlaceholderText="Artist" />
                    <local:TextField
                        x:Name="Book_PublisherTextField"
                        FieldClassId="publisher"
                        HorizontalOptions="Fill"
                        PlaceholderText="Publisher" />

                    <local:TextField
                        x:Name="Book_VolumeTextField"
                        FieldClassId="volume"
                        HorizontalOptions="Start"
                        InputFieldType="{x:Static maui:Keyboard.Numeric}"
                        PlaceholderText="Volume"
                        TextWidth="150" />

                    <local:RadioButtons
                        x:Name="Book_FormatRadioButtons"
                        HorizontalOptions="Start"
                        LabelText="Format" />
                    <local:RadioButtons
                        x:Name="Book_TypeRadioButtons"
                        HorizontalOptions="Start"
                        LabelText="Format" />
                    <local:Combobox
                        x:Name="Book_Genre"
                        HorizontalOptions="Fill"
                        PlaceholderText="Genre"
                        SelectionChanged="" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <local:FilePicker x:Name="Book_FilePicker" />
                </VerticalStackLayout>
            </Grid>
            <HorizontalStackLayout Padding="4" HorizontalOptions="End">
                <Button
                    Margin="4"
                    Clicked="Button_Clicked"
                    HorizontalOptions="End"
                    Text="Cancel" />
                <Button
                    Margin="4"
                    Clicked="AddButton_Clicked"
                    HorizontalOptions="End"
                    Text="Add Book" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>