<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Front.Components.Books.BookView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1.Components.ScrollDisplay"
    Title="">
    <ScrollView Orientation="Vertical">
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Fill">
            <Label
                HorizontalOptions="Center"
                Text="Books"
                VerticalOptions="Center" />
            <local:ScrollViewDisplay x:Name="BookView_All" LabelText="All" />
            <local:ScrollViewDisplay x:Name="BookView_Novels" LabelText="Novels" />
            <local:ScrollViewDisplay x:Name="BookView_Manga" LabelText="Manga" />
            <local:ScrollViewDisplay x:Name="BookView_LightNovels" LabelText="Light novels" />
            <local:ScrollViewDisplay x:Name="BookView_Series" LabelText="Series" />
            <local:ScrollViewDisplay x:Name="BookView_EBooks" LabelText="EBooks" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>