<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiApp1.Front.Components.Shared.RadioButtons"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="this">
    <VerticalStackLayout Padding="8,8,8,8">
        <Label
            x:Name="radio_label"
            ClassId="{Binding Source={x:Reference this}, Path=FieldClassId}"
            HorizontalOptions="Center"
            Text="{Binding Source={x:Reference this}, Path=LabelText}"
            VerticalOptions="Center" />
        <StackLayout
            x:Name="RadioButtonGroup"
            Padding="8,0,8,0"
            Orientation="Horizontal"
            RadioButtonGroup.GroupName="{Binding Source={x:Reference this}, Path=LabelText}" />

    </VerticalStackLayout>
</ContentView>
