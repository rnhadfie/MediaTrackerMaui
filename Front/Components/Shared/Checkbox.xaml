<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiApp1.Front.Components.Shared.Checkbox"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <HorizontalStackLayout>
        <CheckBox
            x:Name="checkbox_section"
            ClassId="{Binding Source={x:Reference this}, Path=FieldClassId}"
            IsChecked="{Binding Source={x:Reference this}, Path=Value}" />
        <Label
            x:Name="label"
            ClassId="{Binding Source={x:Reference this}, Path=FieldClassId}"
            HorizontalOptions="Center"
            Text="{Binding Source={x:Reference this}, Path=LabelText}"
            VerticalOptions="Center" />
    </HorizontalStackLayout>
</ContentView>
