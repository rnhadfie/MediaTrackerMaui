<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiApp1.Front.Components.Shared.FilePicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="this">
    <VerticalStackLayout Padding="8,8,8,8">
        <Image
            x:Name="previewImage"
            Aspect="AspectFit"
            BackgroundColor="LightGray"
            HeightRequest="150"
            HorizontalOptions="Fill"
            IsVisible="True"
            Source="not_applicable.png"
            WidthRequest="100" />
        <ImageButton
            x:Name="filePickButton"
            Margin="75,-25,-5,0"
            Padding="8,8,8,8"
            BackgroundColor="White"
            BorderColor="Black"
            BorderWidth="2"
            Clicked="OnPickFileButtonClicked"
            CornerRadius="32"
            HeightRequest="24"
            HorizontalOptions="Center"
            Source="icons_add_50.png"
            WidthRequest="24" />
        <HorizontalStackLayout>

            <Label
                x:Name="fileNameLabel"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Start"
                VerticalOptions="Center" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentView>
