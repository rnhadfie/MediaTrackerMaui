<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiApp1.Front.Components.Shared.ListDisplay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:models="clr-namespace:MauiApp1.BackEnd.Models"
    xmlns:viewModels="clr-namespace:MauiApp1.Front.Components.Books.ViewModels"
    x:Name="this">

    <!-- Material:DataGrid usage (columns use property names 'Text' and 'Value' on TextValue<string,int>) -->
    <material:DataGrid x:Name="DataGrid" ItemsSource="{Binding ItemsSource, Source={x:Reference this}}">

        <material:DataGrid.EmptyView>
            <Label
                Padding="12"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="{Binding EmptyViewText, Source={x:Reference this}}"
                VerticalOptions="Center"
                VerticalTextAlignment="Center" />
        </material:DataGrid.EmptyView>

        <material:DataGrid.Columns>
            <material:DataGridColumn
                x:Name="TextColumn"
                Title="{Binding Title}" 
                ValueBinding="{Binding Text}" Width="*"/>
            <material:DataGridColumn x:Name="ValueColumn" ValueBinding="{Binding Value}" Width="*"/>
        </material:DataGrid.Columns>
    </material:DataGrid>
</ContentView>